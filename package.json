{
  "name": "unlike-other-authenticator",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.22.0",
  "workspaces": [
    "API",
    "Auth",
    "Admin",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @uoa/api dev",
    "dev:auth": "pnpm --filter @uoa/auth dev",
    "dev:admin": "pnpm --filter @uoa/admin dev",
    "billing:provision-stripe-catalog": "pnpm --filter @uoa/api billing:provision-stripe-catalog",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier -w .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.15.2",
      "brace-expansion": "^5.0.8",
      "@opentelemetry/propagator-jaeger": "^2.9.0",
      "deepmerge-ts@<8.0.0": "^8.0.1",
      "fast-uri": "^3.1.3",
      "fast-xml-builder": "^1.1.7",
      "form-data": "^4.0.6",
      "handlebars": "^4.7.9",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "postcss": "^8.5.18",
      "protobufjs": "^7.5.6",
      "undici": "^6.27.0",
      "vite": "^6.4.3",
      "ws": "^7.5.11"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-67mh-4wv8-2f99",
        "GHSA-g7r4-m6w7-qqqr",
        "GHSA-gv7w-rqvm-qjhr"
      ]
    }
  }
}
