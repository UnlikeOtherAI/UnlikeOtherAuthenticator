                          "budget_run_owner_sub"
                        ],
                        "properties": {
                          "project_id": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "uuid"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "run_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "run_started_at": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "run_owner_sub": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 160
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "budget_run_id": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "uuid"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "budget_run_started_at": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "budget_run_owner_sub": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 160
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Content-free usage and prepaid billing result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "reservation_id",
                    "dispatch_id",
                    "policy_id",
                    "state",
                    "can_dispatch",
                    "reserved_credits",
                    "consumed_credits",
                    "session_id",
                    "max_duration_seconds",
                    "claim_expires_at"
                  ],
                  "properties": {
                    "reservation_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "dispatch_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "policy_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "state": {
                      "enum": [
                        "reserved",
                        "dispatching",
                        "settled",
                        "released",
                        "reconciliation"
                      ]
                    },
                    "can_dispatch": {
                      "type": "boolean"
                    },
                    "reserved_credits": {
                      "type": "string",
                      "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
                      "maxLength": 80
                    },
                    "consumed_credits": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
                          "maxLength": 80
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "session_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "uuid"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "max_duration_seconds": {
                      "type": "integer",
                      "minimum": 60,
                      "maximum": 1800
                    },
                    "claim_expires_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Insufficient prepaid credits or budget; do not start a provider session."
          },
          "409": {
            "description": "Conflicting attribution or evidence; do not retry provider creation."
          },
          "503": {
            "description": "Billing or current provider pricing is unavailable; do not start a provider session."
          }
        }
      }
