{
  "openapi": "3.1.0",
  "info": {
    "title": "UOA prepaid cloud browsers",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "appKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-UOA-App-Key"
      },
      "actor": {
        "type": "apiKey",
        "in": "header",
        "name": "X-UOA-Actor"
      }
    }
  },
  "paths": {
    "/billing/v1/browser/tariff": {
      "post": {
        "operationId": "browser_tariff",
        "description": "Requires BROWSER_RUNTIME. Actor assertions name this exact endpoint. Receipt and cancellation calls use the original reservation, without renewing human authority.",
        "security": [
          {
            "appKey": [],
            "actor": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "product",
                  "organisation_id",
                  "team_id",
                  "user_id",
                  "project_id"
                ],
                "properties": {
                  "product": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "organisation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "team_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "user_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "project_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Content-free usage and prepaid billing result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "policy_id",
                    "project_id",
                    "currency",
                    "provider_price_per_hour",
                    "customer_price_per_minute",
                    "markup_bps",
                    "minimum_seconds",
                    "rounding_seconds",
                    "valid_until"
                  ],
                  "properties": {
                    "policy_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "project_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "currency": {
                      "const": "USD"
                    },
                    "provider_price_per_hour": {
                      "type": "string",
                      "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
                      "maxLength": 80
                    },
                    "customer_price_per_minute": {
                      "type": "string",
                      "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
                      "maxLength": 80
                    },
                    "markup_bps": {
                      "const": 1000
                    },
                    "minimum_seconds": {
                      "const": 60
                    },
                    "rounding_seconds": {
                      "const": 60
                    },
                    "valid_until": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Insufficient prepaid credits or budget; do not start a provider session."
          },
          "409": {
            "description": "Conflicting attribution or evidence; do not retry provider creation."
          },
          "503": {
            "description": "Billing or current provider pricing is unavailable; do not start a provider session."
          }
        }
      }
    },
    "/billing/v1/browser/reservations": {
      "post": {
        "operationId": "browser_reserve",
        "description": "Requires BROWSER_RUNTIME. Actor assertions name this exact endpoint. Receipt and cancellation calls use the original reservation, without renewing human authority.",
        "security": [
          {
            "appKey": [],
            "actor": []
          }
        ],
        "requestBody": {
          "required": true,
