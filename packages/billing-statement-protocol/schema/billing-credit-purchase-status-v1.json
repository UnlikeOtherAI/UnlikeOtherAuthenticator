{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/schemas/billing-credit-purchase-status-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purchase_id",
    "state",
    "title",
    "message",
    "awaiting_confirmation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "purchase_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "enum": [
        "open",
        "processing",
        "requires_action",
        "succeeded",
        "failed",
        "expired",
        "needs_review"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "awaiting_confirmation": {
      "type": "boolean"
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redirect_url",
        "purchase_id"
      ],
      "properties": {
        "redirect_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://checkout\\.stripe\\.com/"
        },
        "purchase_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
