          "type": "object",
          "additionalProperties": false,
          "required": [
            "team_id",
            "user_id"
          ],
          "properties": {
            "team_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "user_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "access": {
          "enum": [
            "full",
            "limited"
          ]
        },
        "full_access": {
          "type": "boolean"
        },
        "history_window_days": {
          "enum": [
            14,
            null
          ]
        },
        "trial_ends_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "seats": {
          "type": "object",
          "additionalProperties": false,
