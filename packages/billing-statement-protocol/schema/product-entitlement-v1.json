            "policy",
            "capacity",
            "admitted",
            "can_admit_members"
          ],
          "properties": {
            "policy": {
              "enum": [
                "free",
                "automatic",
                "fixed"
              ]
            },
            "capacity": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "admitted": {
              "type": "boolean"
            },
            "can_admit_members": {
              "type": "boolean"
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capacity_bytes",
            "used_bytes",
            "observed_at",
            "can_upload",
            "expansion_setup_required"
          ],
          "properties": {
            "capacity_bytes": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$"
            },
            "used_bytes": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,18})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observed_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "can_upload": {
              "type": "boolean"
            },
            "expansion_setup_required": {
              "type": "boolean"
            }
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "viewer": {
          "const": "member"
