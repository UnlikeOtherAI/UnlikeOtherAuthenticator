    "ensure_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "organisation_id",
        "schema_version",
        "operation_id",
        "state",
        "capacity_bytes",
        "required_blocks",
        "grace_ends_at"
      ],
