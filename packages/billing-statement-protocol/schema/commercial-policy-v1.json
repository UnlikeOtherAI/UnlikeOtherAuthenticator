                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "uniqueItems": true
              },
              "channels": {
                "type": "array",
                "items": {
                  "enum": [
                    "alert",
                    "personal_assistant",
                    "email"
                  ]
                },
                "uniqueItems": true
              },
              "resource_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
